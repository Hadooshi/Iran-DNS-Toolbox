<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DNSChanger</AssemblyName>
    <RootNamespace>DNSChangerApp</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>Arezoo / Hadooshi</Authors>
    <Company>Arezoo</Company>
    <Product>1-Click DNS Changer &amp; Anti-Sanction</Product>
    <Description>Fast 1-Click DNS Changer &amp; Live Anti-Sanction Verifier for Windows 10/11</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
